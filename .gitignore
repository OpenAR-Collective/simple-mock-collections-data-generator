# Generated output. Run "python generate.py" to produce these locally.
data/
data_*/
*.csv
# Answer keys are regenerated on every run, so tracking them is pure churn.
ANSWER_KEY*.md
# Release archives, built by package.py and attached to a GitHub Release. A zip
# cannot be delta compressed, so committing one adds a full copy to history
# on every rebuild.
dist/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
